# ProofLayer Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Security & Cryptographic Audit
# Optional base64-encoded Ed25519 32-byte seed for deterministic audit signing key in dev/test
# If unset, a secure key pair will be generated automatically on first startup and persisted.
PROOFLAYER_AUDIT_PRIVATE_KEY=
PROOFLAYER_AUDIT_KEY_ID=dev-key-1

# Policy Engine
PROOFLAYER_DEFAULT_POLICY=strict-bank
PROOFLAYER_POLICIES_DIR=./policies

# Red Team & Sandbox Target
# Restricts targets to localhost / private network by default
PROOFLAYER_ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,sandbox
PROOFLAYER_SANDBOX_PORT=8001

# Model Provider (Optional; NaiveSimLLM simulated model runs offline with zero keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Console
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_SANDBOX_URL=http://localhost:8001
